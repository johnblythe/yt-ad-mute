{
  "manifest_version": 3,
  "name": "YT Ad Mute",
  "version": "1.3.0",
  "description": "Mutes YouTube ads, clicks Skip the moment it's offered, unmutes when the ad is over, and auto-answers \"Continue watching?\".",
  "permissions": ["debugger"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.youtube-nocookie.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.youtube-nocookie.com/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
